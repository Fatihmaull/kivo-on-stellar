# Copy this file to .env.local and fill in your own deployed contract
# addresses (see the root README's "Deployment" section for the CLI
# commands that produce them).

NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Must match the domain the app is actually served from — WebAuthn embeds
# this into every passkey it creates and verifies. "localhost" is fine for
# local dev; a deployed app needs its real domain (e.g. kivo.vercel.app).
NEXT_PUBLIC_RP_ID=localhost

NEXT_PUBLIC_SMART_ACCOUNT_CONTRACT_ID=
NEXT_PUBLIC_RECOVERY_CONTRACT_ID=
NEXT_PUBLIC_POLICY_CONTRACT_ID=
NEXT_PUBLIC_PAYMASTER_CONTRACT_ID=
NEXT_PUBLIC_NATIVE_SAC_CONTRACT_ID=
